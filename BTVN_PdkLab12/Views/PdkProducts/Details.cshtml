@model BTVN_PdkLab12.Models.PdkProduct

@{
    ViewData["Title"] = "Chi tiết sản phẩm";
}

<h2 class="my-3">Chi tiết sản phẩm</h2>
<hr />

<div class="row">
    <div class="col-md-4 text-center mb-3">
        @if (!string.IsNullOrEmpty(Model.PdkImage))
        {
            <img src="~/Product/@Model.PdkImage" class="img-fluid rounded border shadow-sm" alt="@Model.PdkName" style="max-height: 300px; object-fit: cover;" />
        }
        else
        {
            <div class="p-5 bg-light border rounded text-muted">Chưa có ảnh</div>
        }
    </div>

    <div class="col-md-8">
        <dl class="row">
            <dt class="col-sm-3">Tên sản phẩm</dt>
            <dd class="col-sm-9 fw-bold">@Model.PdkName</dd>

            <dt class="col-sm-3">Danh mục</dt>
            <dd class="col-sm-9">@(Model.PdkCategory != null ? Model.PdkCategory.PdkName : "N/A")</dd>

            <dt class="col-sm-3">Giá nhập</dt>
            <dd class="col-sm-9 text-secondary">@Model.PdkPrice.ToString("N0") VNĐ</dd>

            <dt class="col-sm-3">Giá bán</dt>
            <dd class="col-sm-9 text-danger fw-bold">@Model.PdkSalePrice.ToString("N0") VNĐ</dd>

            <dt class="col-sm-3">Trạng thái</dt>
            <dd class="col-sm-9">
                @if (Model.PdkStatus == 1)
                {
                    <span class="badge bg-success">Hiển thị</span>
                }
                else
                {
                    <span class="badge bg-secondary">Ẩn</span>
                }
            </dd>

            <dt class="col-sm-3">Ngày tạo</dt>
            <dd class="col-sm-9">@Model.PdkCreatedDate.ToString("dd/MM/yyyy HH:mm")</dd>

            <dt class="col-sm-3">Mô tả</dt>
            <dd class="col-sm-9">@(string.IsNullOrEmpty(Model.PdkDescriptions) ? "Không có mô tả" : Model.PdkDescriptions)</dd>
        </dl>

        <div class="mt-4">
            <a asp-action="Edit" asp-route-id="@Model.PdkId" class="btn btn-warning btn-sm">Chỉnh sửa</a>
            <a asp-action="Index" class="btn btn-secondary btn-sm">Quay lại danh sách</a>
        </div>
    </div>
</div>