@using PdkLesson04Lab.Models
@{
    ViewData["Title"] = "Profile";
    var profile = ViewBag.PdkAccount as PdkAccount;
}

<div class="row">
    <div class="col-md-4">
        <div class="border-1 p-5">
            <img src="@profile.Avatar" alt="@profile.Name" class="img-fluid rounded" />
        </div>
    </div>
    <div class="col-md-8">
        <div class="card p-5">
            <h3>FullName: @profile.Name</h3>
            <p>Email: @profile.Email</p>
            <p>Address: @profile.Address</p>
            <p>Phone: @profile.Phone</p>
            <p>Bio: @profile.Bio</p>
            <p>
                Gender:
                @if (profile.Gender == 1)
                {
                    <text>Nam</text>
                }
                else
                {
                    <text>Nữ</text>
                }
            </p>
            <p>Birthday: @profile.Birthday</p>

            <p>
                <a asp-controller="PdkAccount" asp-action="PdkIndex" class="btn btn-danger">
                    Back to list
                </a>
            </p>
        </div>
    </div>
</div>