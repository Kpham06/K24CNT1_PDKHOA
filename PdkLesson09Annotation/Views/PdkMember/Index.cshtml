@model IEnumerable<PdkLesson09Annotation.Models.DataModels.PdkMember>

@{
    ViewData["Title"] = "Danh sách thành viên";
}

<h1>@ViewData["Title"]</h1>

<p>
    <a asp-action="Create" class="btn btn-primary">Create New</a>
</p>
<table class="table table-bordered table-striped">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.PdkMemberId)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.PdkUserName)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.PdkPassword)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.PdkEmail)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.PdkPhoneNumber)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.PdkFullName)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.PdkBirthday)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
    @if (Model != null && Model.Any())
    {
        @foreach (var item in Model) {
            <tr>
                <td>
                    @Html.DisplayFor(modelItem => item.PdkMemberId)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.PdkUserName)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.PdkPassword)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.PdkEmail)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.PdkPhoneNumber)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.PdkFullName)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.PdkBirthday)
                </td>
                <td>
                    <a asp-action="Edit" asp-route-id="@item.PdkMemberId">Edit</a> |
                    <a asp-action="Details" asp-route-id="@item.PdkMemberId">Details</a> |
                    <a asp-action="Delete" asp-route-id="@item.PdkMemberId">Delete</a>
                </td>
            </tr>
        }
    }
    </tbody>
</table>