@model IEnumerable<PdkNetCoreCRUD.Models.PdkCategory>
@{
    ViewData["Title"] = "Danh sách danh mục";
}

<h2>Danh sách danh mục</h2>
<p>
    <a class="btn btn-sm btn-success" asp-action="Create">Thêm mới danh mục</a>
</p>
<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.PdkName)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.PdkStatus)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.PdkCreatedDate)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>
                    @Html.DisplayFor(modelItem => item.PdkName)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.PdkStatus)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.PdkCreatedDate)
                </td>
                <td>
                    <a class="btn btn-sm btn-primary" asp-action="Edit" asp-route-pdkid="@item.PdkId">Edit</a> |
                    <a class="btn btn-sm btn-success" asp-action="Details" asp-route-pdkid="@item.PdkId">Details</a> |
                    <a class="btn btn-sm btn-danger" asp-action="Delete" asp-route-pdkid="@item.PdkId">Delete</a>
                </td>
            </tr>
        }
    </tbody>
</table>