@model IEnumerable<Product>
@{
    ViewData["Title"] = "Trang chủ - Thế Giới Di Động Đăng Khoa";
}

<style>
    /* 1. Keyframe tạo hiệu ứng LED quét màu liên tục */
    @@keyframes ledGlow {
        0% { background-position: 0% 50%; }
        50% { background-position: 100% 50%; }
        100% { background-position: 0% 50%; }
    }

    /* 2. Banner với hiệu ứng LED RGB chuyên nghiệp */
    .led-banner {
        /* Dải màu LED phong cách Neon/Cyberpunk năng động */
        background: linear-gradient(124deg, #ff0055, #7928ca, #0070f3, #00dfd8, #7928ca, #ff0055);
        background-size: 500% 500%;
        /* Chạy liên tục trong 6 giây, độ mượt cao */
        animation: ledGlow 6s linear infinite;
        border-radius: 12px;
        position: relative;
        overflow: hidden;
        /* Đường viền phát sáng nhẹ giống viền LED */
        box-shadow: 0 0 20px rgba(0, 112, 243, 0.4);
    }

    /* Lớp phủ dải đen mờ giúp chữ trắng dễ đọc trên nền LED sáng */
    .led-banner-overlay {
        background: rgba(0, 0, 0, 0.35);
        backdrop-filter: blur(2px);
        width: 100%;
        height: 100%;
        padding: 3.5rem 1rem;
    }

    /* 3. Style cho Product Card */
    .product-card {
        transition: all 0.3s ease;
        border: 1px solid #eef0f2 !important;
        border-radius: 10px;
    }

    .product-card:hover {
        transform: translateY(-6px);
        box-shadow: 0 10px 25px rgba(0, 0, 0, 0.1);
        border-color: #0070f3 !important;
    }

    .card-img-container {
        height: 190px;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 15px;
    }

    .product-price {
        color: #e63946;
        font-weight: 700;
        font-size: 1.1rem;
    }

    .text-truncate-2 {
        display: -webkit-box;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;  
        overflow: hidden;
    }
</style>

<!-- LED Moving Banner -->
<div class="led-banner mb-5 text-white text-center">
    <div class="led-banner-overlay">
        <div class="container">
            <div class="d-flex justify-content-center align-items-center mb-3">
                <span class="fs-1 me-3">⚡</span>
                <h1 class="display-4 fw-black m-0 text-uppercase tracking-wider" style="letter-spacing: 1.5px; text-shadow: 0 2px 10px rgba(0,0,0,0.5);">
                    THẾ GIỚI DI ĐỘNG ĐĂNG KHOA
                </h1>
                <span class="fs-1 ms-3">⚡</span>
            </div>
            
            <p class="lead mb-4 text-white-50 mx-auto" style="max-width: 680px; font-weight: 400;">
                Hệ thống bán lẻ thiết bị di động & phụ kiện công nghệ chính hãng. 
                Đồng hành cùng bạn trên từng trải nghiệm số!
            </p>
            
            <a href="#danh-sach" class="btn btn-light btn-lg px-5 py-2 fw-bold text-dark rounded-pill shadow-lg border-0">
                MUA NGAY
            </a>
        </div>
    </div>
</div>

<!-- Product Grid Section -->
<div class="container" id="danh-sach">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h3 class="text-dark fw-bold m-0">Danh Sách Sản Phẩm Nổi Bật</h3>
        <a asp-controller="Product" asp-action="Index" class="btn btn-outline-dark btn-sm rounded-pill px-3">Quản lý</a>
    </div>

    <div class="row g-4">
        @foreach (var item in Model)
        {
            <div class="col-md-3">
                <div class="card h-100 product-card text-center bg-white">
                    <div class="card-img-container">
                        <img src="@item.Image" class="img-fluid" alt="@item.Name" style="max-height: 160px; object-fit: contain;">
                    </div>
                    <div class="card-body d-flex flex-column justify-content-between pt-0">
                        <h6 class="card-title text-dark mb-2 text-truncate-2" style="min-height: 40px; font-size: 0.95rem;">@item.Name</h6>
                        <p class="product-price mb-3">@item.Price.ToString("N0") đ</p>
                        <a href="#" class="btn btn-primary btn-sm w-100 rounded-pill">Xem chi tiết</a>
                    </div>
                </div>
            </div>
        }
    </div>
</div>