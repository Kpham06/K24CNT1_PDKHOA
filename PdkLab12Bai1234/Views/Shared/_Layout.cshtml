<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - PdkLab12Bai1234</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-sm navbar-dark bg-dark border-bottom box-shadow mb-3 py-2">
            <div class="container">
                <a class="navbar-brand fw-bold text-warning" asp-controller="PdkHome" asp-action="PdkIndex">PdkLab12Bai1234</a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    <ul class="navbar-nav flex-grow-1 ms-3">
                        <li class="nav-item me-2">
                            <a class="nav-link text-white fw-semibold" asp-controller="PdkHome" asp-action="PdkIndex">Trang Chủ (Banner)</a>
                        </li>
                        <li class="nav-item me-2">
                            <a class="nav-link text-white fw-semibold" asp-controller="PdkProduct" asp-action="PdkIndex">Quản Lý Sản Phẩm</a>
                        </li>
                        <li class="nav-item me-2">
                            <a class="nav-link text-white fw-semibold" asp-controller="PdkBanner" asp-action="PdkIndex">Quản Lý Banner</a>
                        </li>
                    </ul>
                </div>
            </div>
        </nav>
    </header>

    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted text-center py-3 mt-4">
        <div class="container">
            &copy; 2026 - PdkLab12Bai1234
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>