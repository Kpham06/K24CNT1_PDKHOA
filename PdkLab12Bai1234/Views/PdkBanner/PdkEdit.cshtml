@model PdkLab12Bai1234.Models.PdkBanner

@{
    ViewData["Title"] = "Chỉnh Sửa Banner";
}

<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card shadow-sm">
                <div class="card-header bg-warning text-dark">
                    <h4 class="mb-0 fw-bold">Cập Nhật Banner</h4>
                </div>
                <div class="card-body">
                    <form asp-controller="PdkBanner" asp-action="PdkEdit" method="post">
                        <input type="hidden" asp-for="PdkId" />
                        <input type="hidden" asp-for="PdkCreatedDate" />

                        <div class="mb-3">
                            <label class="form-label fw-bold">Tên Banner</label>
                            <input asp-for="PdkName" class="form-class form-control" required />
                            <span asp-validation-for="PdkName" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label class="form-label fw-bold">Tên File Ảnh (vd: banner1.jpg)</label>
                            <input asp-for="PdkImage" class="form-control" />
                            <span asp-validation-for="PdkImage" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label class="form-label fw-bold">Mô Tả Banner</label>
                            <textarea asp-for="PdkDescription" class="form-control" rows="3"></textarea>
                            <span asp-validation-for="PdkDescription" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label class="form-label fw-bold">Trạng Thái</label>
                            <select asp-for="PdkStatus" class="form-select">
                                <option value="1">Hiển Thị</option>
                                <option value="0">Ẩn</option>
                            </select>
                        </div>

                        <div class="d-flex justify-content-between mt-4">
                            <a asp-controller="PdkHome" asp-action="PdkIndex" class="btn btn-secondary">Quay lại</a>
                            <button type="submit" class="btn btn-primary">Lưu Thay Đổi</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}