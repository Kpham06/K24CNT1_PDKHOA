@model PdkLab12Bai1234.Models.PdkProduct

@{
    ViewData["Title"] = "Chỉnh sửa sản phẩm";
}

<div class="container mt-4">
    <h2 class="mb-4 fw-bold">Chỉnh sửa sản phẩm</h2>

    <form asp-action="PdkEdit" asp-route-id="@Model.PdkId" method="post">
        <input type="hidden" asp-for="PdkId" />
        <input type="hidden" asp-for="PdkCreatedDate" />

        <div class="row">
            <div class="col-md-6 mb-3">
                <label class="form-label fw-bold">Tên sản phẩm</label>
                <input asp-for="PdkName" class="form-control" required />
            </div>

            <div class="col-md-6 mb-3">
                <label class="form-label fw-bold">Mã Danh mục (PdkCategoryId)</label>
                <input asp-for="PdkCategoryId" type="number" class="form-control" />
            </div>

            <div class="col-md-6 mb-3">
                <label class="form-label fw-bold">Đường dẫn Hình ảnh</label>
                <input asp-for="PdkImage" class="form-control" />
            </div>

            <div class="col-md-6 mb-3">
                <label class="form-label fw-bold">Giá bán</label>
                <input asp-for="PdkPrice" type="number" step="0.01" class="form-control" />
            </div>

            <div class="col-md-6 mb-3">
                <label class="form-label fw-bold">Giá khuyến mãi</label>
                <input asp-for="PdkSalePrice" type="number" step="0.01" class="form-control" />
            </div>

            <div class="col-md-6 mb-3">
                <label class="form-label fw-bold">Trạng thái</label>
                <input asp-for="PdkStatus" type="number" class="form-control" />
            </div>

            <div class="col-md-12 mb-3">
                <label class="form-label fw-bold">Mô tả sản phẩm</label>
                <textarea asp-for="PdkDescriptions" class="form-control" rows="3"></textarea>
            </div>
        </div>

        <div class="mt-3">
            <button type="submit" class="btn btn-primary me-2">Cập nhật</button>
            <a asp-action="PdkIndex" class="btn btn-secondary">Về danh sách</a>
        </div>
    </form>
</div>