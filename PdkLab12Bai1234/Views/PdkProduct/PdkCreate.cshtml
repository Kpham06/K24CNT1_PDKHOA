@model PdkLab12Bai1234.Models.PdkProduct

@{
    ViewData["Title"] = "Thêm mới sản phẩm";
}

<div class="container mt-4">
    <h2 class="mb-4 fw-bold">Thêm mới sản phẩm</h2>

    <form asp-action="PdkCreate" method="post">
        <div class="row">
            <div class="col-md-6 mb-3">
                <label class="form-label fw-bold">Tên sản phẩm</label>
                <input asp-for="PdkName" class="form-control" required />
                <span asp-validation-for="PdkName" class="text-danger"></span>
            </div>

            <div class="col-md-6 mb-3">
                <label class="form-label fw-bold">Danh mục sản phẩm</label>
                <select asp-for="PdkCategoryId" class="form-select" asp-items="ViewBag.PdkCategoryId" required>
                    <option value="">-- Chọn danh mục --</option>
                </select>
                <span asp-validation-for="PdkCategoryId" class="text-danger"></span>
            </div>

            <div class="col-md-6 mb-3">
                <label class="form-label fw-bold">Đường dẫn Hình ảnh</label>
                <input asp-for="PdkImage" class="form-control" placeholder="/images/laptop.jpg" />
            </div>

            <div class="col-md-6 mb-3">
                <label class="form-label fw-bold">Giá bán</label>
                <input asp-for="PdkPrice" type="number" step="0.01" class="form-control" required />
                <span asp-validation-for="PdkPrice" class="text-danger"></span>
            </div>

            <div class="col-md-6 mb-3">
                <label class="form-label fw-bold">Giá khuyến mãi</label>
                <input asp-for="PdkSalePrice" type="number" step="0.01" class="form-control" />
            </div>

            <div class="col-md-6 mb-3">
                <label class="form-label fw-bold">Trạng thái (1: Hiện, 0: Ẩn)</label>
                <input asp-for="PdkStatus" type="number" class="form-control" value="1" />
            </div>

            <div class="col-md-12 mb-3">
                <label class="form-label fw-bold">Mô tả sản phẩm</label>
                <textarea asp-for="PdkDescriptions" class="form-control" rows="3"></textarea>
            </div>
        </div>

        <div class="mt-3">
            <button type="submit" class="btn btn-success me-2">Tạo mới</button>
            <a asp-action="PdkIndex" class="btn btn-secondary">Về danh sách</a>
        </div>
    </form>
</div>