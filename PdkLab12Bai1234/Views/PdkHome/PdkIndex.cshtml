@model IEnumerable<PdkLab12Bai1234.Models.PdkBanner>

@{
    ViewData["Title"] = "Trang Chủ - Banner";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2 class="text-primary fw-bold">Danh Sách Banner</h2>
        <a asp-controller="PdkBanner" asp-action="PdkCreate" class="btn btn-success">
            + Thêm Banner Mới
        </a>
    </div>

    <div class="card shadow-sm">
        <div class="card-body p-0">
            <table class="table table-hover table-striped align-middle mb-0 text-center">
                <thead class="table-dark">
                    <tr>
                        <th>STT</th>
                        <th>Hình Ảnh</th>
                        <th>Tên Banner</th>
                        <th>Mô Tả</th>
                        <th>Trạng Thái</th>
                        <th>Ngày Tạo</th>
                        <th>Thao Tác</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.Any())
                    {
                        int stt = 1;
                        foreach (var item in Model)
                        {
                            <tr>
                                <td>@(stt++)</td>
                                <td>
                                    @if (!string.IsNullOrEmpty(item.PdkImage))
                                    {
                                        <img src="~/images/@item.PdkImage" alt="@item.PdkName" class="img-thumbnail" style="max-height: 60px; object-fit: cover;" onerror="this.onerror=null; this.src='https://via.placeholder.com/150x60?text=No+Image';" />
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary">Không có ảnh</span>
                                    }
                                </td>
                                <td class="fw-bold">@item.PdkName</td>
                                <td>@item.PdkDescription</td>
                                <td>
                                    @if (item.PdkStatus == 1)
                                    {
                                        <span class="badge bg-success">Hiển thị</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-danger">Ẩn</span>
                                    }
                                </td>
                                <td>@item.PdkCreatedDate.ToString("dd/MM/yyyy HH:mm")</td>
                                <td>
                                    <a asp-controller="PdkBanner" asp-action="PdkEdit" asp-route-id="@item.PdkId" class="btn btn-sm btn-warning">Sửa</a>
                                    <a asp-controller="PdkBanner" asp-action="PdkDelete" asp-route-id="@item.PdkId" class="btn btn-sm btn-danger">Xóa</a>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="7" class="text-muted py-4">Chưa có dữ liệu banner nào!</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>