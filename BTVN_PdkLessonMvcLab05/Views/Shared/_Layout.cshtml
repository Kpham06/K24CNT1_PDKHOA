<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>@ViewData["Title"] - PDK DEMO LAB 5</title>

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/BTVN_PdkLessonMvcLab05.styles.css" asp-append-version="true" />

    <style>
            body {
                margin: 0;
                background: white;
                font-family: Arial, Helvetica, sans-serif;
            }

            .main-container {
                width: 1100px;
                max-width: 100%;
                margin: 0 auto;
            }

            /* LOGO */
            .top-header {
                height: 85px;
                display: flex;
                align-items: center;
                justify-content: space-between;
            }

            .logo {
                font-size: 42px;
                font-weight: bold;
                color: #3b8d2a;
                letter-spacing: -5px;
            }

            .logo .e {
                color: #e27600;
            }

            .logo .v {
                color: #346db5;
            }

            .logo-text {
                font-size: 10px;
                color: #d71920;
                font-weight: bold;
                letter-spacing: 0;
                margin-top: -7px;
            }

            .title-header {
                font-size: 20px;
                font-weight: bold;
                color: #333;
            }

            /* MENU */
            .main-menu {
                background: #222;
                height: 38px;
            }

            .main-menu ul {
                list-style: none;
                padding: 0;
                margin: 0;
                display: flex;
            }

            .main-menu li a {
                display: block;
                color: white;
                text-decoration: none;
                padding: 11px 18px;
                font-size: 13px;
            }

            .main-menu li:first-child a {
                background: #333;
            }

            .main-menu li a:hover {
                background: #337ab7;
            }

            /* CONTENT */
            .content-area {
                display: flex;
                gap: 15px;
                margin-top: 12px;
            }

            .left-column {
                width: 250px;
                flex-shrink: 0;
            }

            .right-column {
                flex: 1;
            }

            /* FOOTER */
            .footer-custom {
                background: #333;
                color: white;
                margin-top: 15px;
                padding: 15px 20px;
            }

            .footer-custom h4 {
                font-size: 14px;
                margin-bottom: 8px;
            }

            .footer-custom p {
                font-size: 10px;
                line-height: 1.5;
                margin: 0;
            }

            .footer-custom .row {
                margin: 0;
            }
    </style>
</head>

<body>

    <div class="main-container">

        <!-- HEADER -->
        <header class="top-header">

            <div>
                <div class="logo">
                    D<span class="e">E</span><span class="v">V</span>
                </div>

                <div class="logo-text">
                    PDKMASTER.EDU.VN
                </div>
            </div>

            <div class="title-header">
                ASP.NET Core MVC
            </div>

        </header>


        <!-- MENU -->
        <nav class="main-menu">
            <ul>
                <li>
                    <a asp-controller="Home" asp-action="Index">
                        Trang chủ
                    </a>
                </li>

                <li>
                    <a asp-controller="Home" asp-action="About">
                        Giới thiệu
                    </a>
                </li>

                <li>
                    <a href="#">
                        Liên hệ
                    </a>
                </li>

                <li>
                    <a href="#">
                        Sản phẩm
                    </a>
                </li>
            </ul>
        </nav>


        <!-- CONTENT -->
        <div class="content-area">

            <!-- CỘT TRÁI -->
            <aside class="left-column">

                @await Html.PartialAsync("_Category")

            </aside>


            <!-- CỘT PHẢI -->
            <main class="right-column">

                @RenderBody()

            </main>

        </div>


        <!-- FOOTER -->
        <footer class="footer-custom">

            <div class="row">

                <div class="col-md-6">
                    <h4>GIỚI THIỆU</h4>

                    <p>
                        Lorem ipsum dolor sit amet consectetur adipisicing elit.
                        Debitis ab suscipit deserunt molestias reiciendis.
                    </p>
                </div>

                <div class="col-md-6">
                    <h4>LIÊN HỆ</h4>

                    <p>
                        Lorem ipsum dolor sit amet consectetur adipisicing elit.
                        Odit amet suscipit quas, numquam impedit magni nobis.
                    </p>
                </div>

            </div>

        </footer>

    </div>


    <!-- JAVASCRIPT -->
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)

</body>
</html>