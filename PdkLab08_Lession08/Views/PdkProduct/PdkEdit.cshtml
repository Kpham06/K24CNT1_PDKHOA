@model PdkLab08_Lession08.Models.PdkProduct

@{
    ViewData["Title"] = "Cập nhật sản phẩm";
}

<div class="card mb-4">
    <div class="card-header">
        <h2>@ViewData["Title"]</h2>
    </div>
    <form asp-action="PdkEdit" method="post">
        <div class="card-body">
            <input type="hidden" asp-for="Id" />
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <div class="row">
                <div class="col-md-8">
                    <div class="form-group mb-3">
                        <label asp-for="Name" class="control-label fw-bold mb-1"></label>
                        <input asp-for="Name" class="form-control" />
                        <span asp-validation-for="Name" class="text-danger"></span>
                    </div>

                    <div class="form-group mb-3">
                        <label asp-for="CategoryId" class="control-label fw-bold mb-1"></label>
                        <select asp-for="CategoryId" class="form-select" asp-items="ViewBag.CategoryId"></select>
                        <span asp-validation-for="CategoryId" class="text-danger"></span>
                    </div>

                    <div class="form-group mb-3">
                        <label asp-for="Price" class="control-label fw-bold mb-1"></label>
                        <input asp-for="Price" class="form-control" type="number" />
                        <span asp-validation-for="Price" class="text-danger"></span>
                    </div>

                    <div class="form-group mb-3">
                        <label asp-for="SalePrice" class="control-label fw-bold mb-1"></label>
                        <input asp-for="SalePrice" class="form-control" type="number" />
                    </div>

                    <div class="form-group mb-3">
                        <label asp-for="Image" class="control-label fw-bold mb-1"></label>
                        <input asp-for="Image" class="form-control" />
                    </div>

                    <div class="form-group mb-3">
                        <label asp-for="Description" class="control-label fw-bold mb-1"></label>
                        <textarea asp-for="Description" class="form-control" rows="3"></textarea>
                    </div>

                    <div class="form-check mb-3">
                        <input asp-for="Status" class="form-check-input" type="checkbox" />
                        <label asp-for="Status" class="form-check-label fw-bold"></label>
                    </div>
                </div>
            </div>
        </div>
        <div class="card-footer p-3">
            <button type="submit" class="btn btn-danger">Cập nhật</button>
            <a asp-action="Index" class="btn btn-secondary ms-2">Quay lại</a>
        </div>
    </form>
</div>