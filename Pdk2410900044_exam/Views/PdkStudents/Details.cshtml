@model Pdk2410900044_exam.Models.PdkStudent

@{
    ViewData["Title"] = "Thông tin sinh viên";
}

<div class="container mt-4">
    <div class="card shadow">
        <div class="card-header bg-info text-white">
            <h3 class="mb-0">THÔNG TIN SINH VIÊN</h3>
        </div>

        <div class="card-body">
            <table class="table table-bordered">
                <tr>
                    <th>Họ và tên</th>
                    <td>@Model.PdkName</td>
                </tr>

                <tr>
                    <th>Giới tính</th>
                    <td>
                        @(Model.PdkGender ? "Nam" : "Nữ")
                    </td>
                </tr>

                <tr>
                    <th>Ngày sinh</th>
                    <td>@Model.PdkBirthDay.ToString("dd/MM/yyyy")</td>
                </tr>

                <tr>
                    <th>Email</th>
                    <td>@Model.PdkEmail</td>
                </tr>

                <tr>
                    <th>Số điện thoại</th>
                    <td>@Model.PdkPhone</td>
                </tr>

                <tr>
                    <th>Trạng thái</th>
                    <td>
                        @(Model.PdkActive ? "Hoạt động" : "Không hoạt động")
                    </td>
                </tr>
            </table>

            <a asp-action="Edit"
               asp-route-id="@Model.Id"
               class="btn btn-warning">
                Sửa
            </a>

            <a asp-action="Index"
               class="btn btn-secondary">
                Quay lại
            </a>
        </div>
    </div>
</div>