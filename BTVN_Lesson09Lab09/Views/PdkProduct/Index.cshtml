@model IEnumerable<BTVN_Lesson09Lab09.Models.PdkProduct>
@{
    ViewData["Title"] = "Danh sách sản phẩm";
    var categories = ViewBag.Categories as List<BTVN_Lesson09Lab09.Models.PdkCategory>;
}

<h2>Danh sách sản phẩm</h2>
<p>
    <a asp-action="Create" class="btn btn-primary">Thêm mới sản phẩm</a>
</p>

<table class="table table-bordered table-striped align-middle">
    <thead class="table-dark">
        <tr>
            <th>Mã</th>
            <th>Hình ảnh</th>
            <th>Tên sản phẩm</th>
            <th>Danh mục</th>
            <th>Giá gốc</th>
            <th>Giá KM</th>
            <th>Hành động</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            var catName = categories?.FirstOrDefault(c => c.Id == item.CategoryId)?.Name;
            <tr>
                <td>@item.Id</td>
                <td>
                    <img src="~/products/@item.Image" style="width:70px; height:70px; object-fit:cover;" class="img-thumbnail" alt="@item.Name" />
                </td>
                <td>@item.Name</td>
                <td>@catName</td>
                <td>@item.Price.ToString("N0") VNĐ</td>
                <td><span class="badge bg-danger">@item.SalePrice.ToString("N0") VNĐ</span></td>
                <td>
                    <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-warning">Sửa</a> |
                    <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-info text-white">Chi tiết</a> |
                    <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-danger">Xóa</a>
                </td>
            </tr>
        }
    </tbody>
</table>